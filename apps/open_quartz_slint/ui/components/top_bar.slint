import { Button, ComboBox, LineEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export component TopBar inherits Rectangle {
    in property <string> project-name;
    in property <string> runtime-status;
    in property <bool> busy;
    in-out property <string> project-path;
    callback open-requested(string);
    callback save-requested(string);
    in property <[string]> renderer-options;
    in property <int> renderer-index: -1;
    in property <bool> native-runtime-available;
    in property <bool> screen-saver-available;
    in property <bool> export-selection-valid;
    callback select-renderer(int);
    callback capture-png();
    callback export-screen-saver();
    callback playback(string);

    background: Theme.panel;
    border-radius: 8px;
    VerticalLayout {
        padding: 12px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 12px;
            Text {
                text: root.project-name;
                color: Theme.foreground;
                font-size: 20px;
                font-weight: 600;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Text {
                text: "Desktop · NativeHost";
                color: Theme.accent;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            LineEdit {
                text <=> root.project-path;
                placeholder-text: "Project JSON path (used for both Open and Save)";
                enabled: !root.busy;
                horizontal-stretch: 1;
                accepted => { root.open-requested(root.project-path); }
            }
            Button {
                text: "Open";
                enabled: !root.busy;
                clicked => { root.open-requested(root.project-path); }
            }
            Button {
                text: "Save";
                enabled: !root.busy;
                clicked => { root.save-requested(root.project-path); }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Text { text: "Renderer"; color: Theme.secondary; vertical-alignment: center; }
            ComboBox {
                model: root.renderer-options;
                current-index: root.renderer-index;
                enabled: !root.busy && root.renderer-options.length > 0;
                horizontal-stretch: 1;
                min-width: 100px;
                preferred-width: 180px;
                selected => { root.select-renderer(self.current-index); }
            }
            Button {
                text: "Capture PNG…";
                enabled: !root.busy && root.native-runtime-available && root.renderer-index >= 0 && root.export-selection-valid;
                clicked => { root.capture-png(); }
            }
            if root.screen-saver-available: Button {
                text: "Export .scr…";
                enabled: !root.busy && root.renderer-index >= 0 && root.export-selection-valid;
                clicked => { root.export-screen-saver(); }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Button { text: "Play"; enabled: !root.busy && root.native-runtime-available; clicked => { root.playback("play"); } }
            Button { text: "Pause"; enabled: !root.busy && root.native-runtime-available; clicked => { root.playback("pause"); } }
            Button { text: "Stop"; enabled: !root.busy && root.native-runtime-available; clicked => { root.playback("stop"); } }
        }
        Text {
            text: root.runtime-status;
            color: Theme.secondary;
            wrap: word-wrap;
        }
    }
}
