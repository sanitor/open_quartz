import { Button, CheckBox, ComboBox, LineEdit, ScrollView, SpinBox, TextEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export struct InspectorPort {
    label: string,
    data-type: string,
    output: bool,
}

export struct InspectorUniform {
    name: string,
    data-type: string,
    value: string,
    connected: bool,
    valid: bool,
    error: string,
}

export struct InspectorFormField {
    key: string,
    label: string,
    value: string,
    kind: string,
    options: [string],
    choice: int,
    checked: bool,
}

export struct InspectorFormGroup {
    key: string,
    title: string,
    hint: string,
    fields: [InspectorFormField],
    dirty: bool,
    error: string,
}

export struct InspectorOnnxRow {
    label: string,
    value: string,
}

export component Inspector inherits Rectangle {
    in property <string> node-id;
    in property <string> node-type;
    in property <string> selection-message;
    in property <bool> project-busy;
    in property <bool> is-shader;
    in property <bool> supports-output-size;
    in property <bool> label-dirty;
    in property <bool> shader-dirty;
    in property <bool> output-size-dirty;
    in property <bool> uniform-dirty;
    in property <bool> inspector-dirty;
    in property <string> validation-message;
    in property <bool> uniforms-valid: true;
    in property <[InspectorPort]> ports;
    in property <[InspectorUniform]> uniforms;
    in property <[InspectorFormGroup]> forms;
    in property <[InspectorOnnxRow]> onnx-config;
    in property <[InspectorOnnxRow]> onnx-saved;
    in-out property <string> node-label;
    in-out property <string> shader-code;
    in-out property <bool> auto-size;
    in-out property <int> output-width;
    in-out property <int> output-height;
    callback label-draft-changed(string);
    callback shader-draft-changed(string);
    callback output-size-draft-changed(int, int, bool);
    callback uniform-draft-changed(string, string);
    callback apply-label();
    callback apply-shader();
    callback apply-output-size();
    callback apply-uniforms();
    callback discard-drafts();
    callback form-draft-changed(string, string);
    callback apply-form(string);

    background: Theme.panel;
    border-radius: 8px;
    min-width: 220px;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        Text { text: "Inspector"; color: Theme.foreground; font-size: 17px; font-weight: 600; }
        if root.inspector-dirty: VerticalLayout {
            spacing: 4px;
            Text { text: "Unapplied drafts · graph and file actions paused"; color: Theme.accent; wrap: word-wrap; font-size: 11px; }
            Button {
                text: "Discard inspector edits";
                enabled: !root.project-busy;
                clicked => { root.discard-drafts(); }
            }
        }
        if root.node-id == "": Text {
            text: root.selection-message;
            color: Theme.secondary;
            wrap: word-wrap;
            vertical-stretch: 1;
            vertical-alignment: center;
        }
        if root.node-id != "": ScrollView {
            content-width: self.visible-width;
            horizontal-scrollbar-policy: always-off;
            VerticalLayout {
                alignment: start;
                spacing: 10px;
                Text { text: root.node-type + " · " + root.node-id; color: Theme.secondary; font-size: 11px; overflow: elide; }

                Text { text: "Name"; color: Theme.foreground; font-size: 13px; font-weight: 600; }
                LineEdit {
                    text <=> root.node-label;
                    enabled: !root.project-busy;
                    placeholder-text: "Node name";
                    edited => { root.label-draft-changed(self.text); }
                }
                Button {
                    text: "Apply name";
                    enabled: root.label-dirty && !root.project-busy;
                    clicked => { root.apply-label(); }
                }

                if root.supports-output-size: VerticalLayout {
                    spacing: 6px;
                    Text { text: "Output"; color: Theme.foreground; font-size: 13px; font-weight: 600; }
                    CheckBox {
                        text: "Auto size";
                        checked <=> root.auto-size;
                        enabled: !root.project-busy;
                        toggled => { root.output-size-draft-changed(root.output-width, root.output-height, root.auto-size); }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "Width"; color: Theme.secondary; vertical-alignment: center; }
                        SpinBox {
                            minimum: 1;
                            maximum: 8192;
                            value <=> root.output-width;
                            enabled: !root.project-busy && !root.auto-size;
                            edited => { root.output-size-draft-changed(root.output-width, root.output-height, root.auto-size); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "Height"; color: Theme.secondary; vertical-alignment: center; }
                        SpinBox {
                            minimum: 1;
                            maximum: 8192;
                            value <=> root.output-height;
                            enabled: !root.project-busy && !root.auto-size;
                            edited => { root.output-size-draft-changed(root.output-width, root.output-height, root.auto-size); }
                        }
                    }
                    Button {
                        text: "Apply output size";
                        enabled: root.output-size-dirty && !root.project-busy;
                        clicked => { root.apply-output-size(); }
                    }
                }

                if root.is-shader: VerticalLayout {
                    spacing: 6px;
                    Text { text: "WGSL source"; color: Theme.foreground; font-size: 13px; font-weight: 600; }
                    TextEdit {
                        text <=> root.shader-code;
                        font-family: "Menlo";
                        font-size: 12px;
                        wrap: no-wrap;
                        enabled: !root.project-busy;
                        min-height: 180px;
                        vertical-stretch: 1;
                        edited => { root.shader-draft-changed(self.text); }
                    }
                    if root.validation-message != "": Text {
                        text: "Shader parse error: " + root.validation-message;
                        color: #ff9b8f;
                        wrap: word-wrap;
                    }
                }

                if root.is-shader && root.uniforms.length > 0: VerticalLayout {
                    spacing: 6px;
                    Text { text: "Uniforms"; color: Theme.foreground; font-size: 13px; font-weight: 600; }
                    Text { text: "Vectors: comma-separated. Matrices: column-major."; color: Theme.secondary; font-size: 11px; wrap: word-wrap; }
                    for uniform in root.uniforms: VerticalLayout {
                        spacing: 4px;
                        Text { text: uniform.name + " · " + uniform.data-type; color: Theme.secondary; wrap: word-wrap; }
                        LineEdit {
                            text: uniform.value;
                            enabled: !uniform.connected && !root.project-busy;
                            edited => { root.uniform-draft-changed(uniform.name, self.text); }
                        }
                        if uniform.connected: Text { text: "Connected · upstream value wins"; color: Theme.accent; wrap: word-wrap; }
                        if !uniform.connected && !uniform.valid: Text {
                            text: uniform.error;
                            color: #ff9b8f;
                            wrap: word-wrap;
                        }
                    }
                    Button {
                        text: "Apply uniforms";
                        enabled: root.uniform-dirty && root.uniforms-valid && !root.project-busy;
                        clicked => { root.apply-uniforms(); }
                    }
                }

                for group in root.forms: VerticalLayout {
                    spacing: 6px;
                    Text { text: group.title; color: Theme.foreground; font-size: 13px; font-weight: 600; }
                    Text { text: group.hint; color: Theme.secondary; font-size: 11px; wrap: word-wrap; }
                    for field in group.fields: VerticalLayout {
                        spacing: 4px;
                        if field.kind != "toggle": Text { text: field.label; color: Theme.secondary; wrap: word-wrap; }
                        if field.kind == "choice": ComboBox {
                            model: field.options;
                            current-index <=> field.choice;
                            enabled: !root.project-busy;
                            selected => { root.form-draft-changed(field.key, "" + self.current-index); }
                        }
                        if field.kind == "text": LineEdit {
                            text <=> field.value;
                            enabled: !root.project-busy;
                            edited => { root.form-draft-changed(field.key, self.text); }
                        }
                        if field.kind == "toggle": CheckBox {
                            text: field.label;
                            checked <=> field.checked;
                            enabled: !root.project-busy;
                            toggled => { root.form-draft-changed(field.key, self.checked ? "true" : "false"); }
                        }
                    }
                    if group.error != "": Text { text: group.error; color: #ff9b8f; wrap: word-wrap; }
                    Button {
                        text: "Apply " + group.key;
                        enabled: group.dirty && group.error == "" && !root.project-busy;
                        clicked => { root.apply-form(group.key); }
                    }
                }

                if root.onnx-config.length > 0: VerticalLayout {
                    spacing: 8px;
                    Text { text: "ONNX · Read-only"; color: Theme.foreground; font-size: 13px; font-weight: 600; }
                    Text {
                        text: "Session: not attached by Slint. Model loading, download and inference controls are not available in this shell.";
                        color: Theme.accent;
                        wrap: word-wrap;
                    }
                    for field in root.onnx-config: VerticalLayout {
                        spacing: 2px;
                        Text { text: field.label; color: Theme.secondary; font-size: 11px; wrap: word-wrap; }
                        Text { text: field.value; color: Theme.foreground; wrap: word-wrap; min-width: 0px; }
                    }
                    if root.onnx-saved.length > 0: VerticalLayout {
                        spacing: 6px;
                        Text { text: "Saved metadata · not live session state"; color: Theme.accent; wrap: word-wrap; }
                        for field in root.onnx-saved: VerticalLayout {
                            spacing: 2px;
                            Text { text: field.label; color: Theme.secondary; font-size: 11px; wrap: word-wrap; }
                            Text { text: field.value; color: Theme.foreground; wrap: word-wrap; min-width: 0px; }
                        }
                    }
                }

                if root.ports.length > 0: VerticalLayout {
                    spacing: 4px;
                    Text { text: "Ports"; color: Theme.foreground; font-size: 13px; font-weight: 600; }
                    for port in root.ports: Text {
                        text: (port.output ? "OUT  " : "IN   ") + port.label + "  ·  " + port.data-type;
                        color: Theme.secondary;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }

            }
        }
        if root.node-id != "" && root.is-shader: Button {
            text: "Apply shader";
            enabled: root.shader-dirty && !root.project-busy;
            clicked => { root.apply-shader(); }
        }
    }
}
