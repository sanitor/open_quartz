import { Button, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export struct GraphPort {
    port-id: string,
    label: string,
    y: float,
    output: bool,
}

export struct GraphNode {
    node-id: string,
    label: string,
    kind: string,
    x: float,
    y: float,
    width: float,
    height: float,
    selected: bool,
    ports: [GraphPort],
}

export struct GraphEdge {
    edge-id: string,
    source-index: int,
    target-index: int,
    source-x: float,
    source-y: float,
    target-x: float,
    target-y: float,
}

export component GraphView inherits Rectangle {
    in property <[GraphNode]> nodes;
    in property <[GraphEdge]> edges;
    in property <string> summary;
    in property <float> content-width;
    in property <float> content-height;
    in property <float> origin-x;
    in property <float> origin-y;
    in property <bool> busy;
    callback node-selected(string);
    callback node-moved(string, float, float);
    in property <string> selected-edge-id;
    in property <string> pending-node-id;
    in property <string> pending-port-id;
    in property <bool> connection-active;
    in property <bool> can-undo;
    in property <bool> can-redo;
    callback port-selected(string, string, bool);
    callback edge-selected(string);
    callback reconnect-edge();
    callback delete-edge();
    callback cancel-connection();
    callback undo();
    callback redo();

    private property <int> drag-node-index: -1;
    private property <length> drag-offset-x: 0px;
    private property <length> drag-offset-y: 0px;

    background: Theme.panel;
    border-radius: 8px;

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        Text {
            text: "Graph · " + root.summary;
            color: Theme.foreground;
            font-size: 17px;
        }

        HorizontalLayout {
            spacing: 4px;
            Button { text: "Undo"; enabled: !root.busy && root.can-undo; clicked => { root.undo(); } }
            Button { text: "Redo"; enabled: !root.busy && root.can-redo; clicked => { root.redo(); } }
            Button { text: "Reconnect"; enabled: !root.busy && root.selected-edge-id != ""; clicked => { root.reconnect-edge(); } }
            Button { text: "Delete edge"; enabled: !root.busy && root.selected-edge-id != ""; clicked => { root.delete-edge(); } }
            Button { text: "Cancel"; enabled: !root.busy && root.connection-active; clicked => { root.cancel-connection(); } }
        }
        Text {
            text: root.connection-active ? "Choose an input to connect; choose an output to change source. Cancel keeps the graph unchanged." : "Output then input connects/replaces. Click a connected input or link marker to select an edge.";
            color: Theme.secondary;
            wrap: word-wrap;
            font-size: 11px;
        }

        ScrollView {
            content-width: root.content-width * 1px;
            content-height: root.content-height * 1px;
            horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;
            vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
            mouse-drag-pan-enabled: false;

            canvas := Rectangle {
                width: root.content-width * 1px;
                height: root.content-height * 1px;
                background: #121925;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: 6px;

                for grid-column in 64: Rectangle {
                    x: grid-column * 64px;
                    width: 1px;
                    height: parent.height;
                    background: #1d2939;
                }
                for grid-row in 64: Rectangle {
                    y: grid-row * 64px;
                    width: parent.width;
                    height: 1px;
                    background: #1d2939;
                }

                for edge in root.edges: Path {
                    width: canvas.width;
                    height: canvas.height;
                    fit: preserve;
                    stroke: root.selected-edge-id == edge.edge-id ? Theme.accent : #56708f;
                    stroke-width: 2px;
                    MoveTo {
                        x: edge.source-x + root.origin-x + (edge.source-index == root.drag-node-index ? root.drag-offset-x / 1px : 0);
                        y: edge.source-y + root.origin-y + (edge.source-index == root.drag-node-index ? root.drag-offset-y / 1px : 0);
                    }
                    CubicTo {
                        control-1-x: edge.source-x + 48 + root.origin-x + (edge.source-index == root.drag-node-index ? root.drag-offset-x / 1px : 0);
                        control-1-y: edge.source-y + root.origin-y + (edge.source-index == root.drag-node-index ? root.drag-offset-y / 1px : 0);
                        control-2-x: edge.target-x - 48 + root.origin-x + (edge.target-index == root.drag-node-index ? root.drag-offset-x / 1px : 0);
                        control-2-y: edge.target-y + root.origin-y + (edge.target-index == root.drag-node-index ? root.drag-offset-y / 1px : 0);
                        x: edge.target-x + root.origin-x + (edge.target-index == root.drag-node-index ? root.drag-offset-x / 1px : 0);
                        y: edge.target-y + root.origin-y + (edge.target-index == root.drag-node-index ? root.drag-offset-y / 1px : 0);
                    }
                }

                for edge in root.edges: Button {
                    x: (edge.source-x + edge.target-x) / 2 * 1px + root.origin-x * 1px
                        + (edge.source-index == root.drag-node-index || edge.target-index == root.drag-node-index ? root.drag-offset-x / 2 : 0px) - 12px;
                    y: (edge.source-y + edge.target-y) / 2 * 1px + root.origin-y * 1px
                        + (edge.source-index == root.drag-node-index || edge.target-index == root.drag-node-index ? root.drag-offset-y / 2 : 0px) - 12px;
                    width: 24px;
                    height: 24px;
                    text: root.selected-edge-id == edge.edge-id ? "●" : "○";
                    accessible-label: "Select connection " + edge.edge-id;
                    enabled: !root.busy;
                    clicked => { root.edge-selected(edge.edge-id); }
                }

                for node[index] in root.nodes: node-area := TouchArea {
                    x: (node.x + root.origin-x) * 1px;
                    y: (node.y + root.origin-y) * 1px;
                    width: node.width * 1px;
                    height: node.height * 1px;
                    enabled: !root.busy;

                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.cancel) {
                            root.drag-node-index = -1;
                            root.drag-offset-x = 0px;
                            root.drag-offset-y = 0px;
                            return;
                        }
                        if (event.button != PointerEventButton.left) {
                            return;
                        }
                        if (event.kind == PointerEventKind.down) {
                            root.drag-node-index = index;
                            root.drag-offset-x = 0px;
                            root.drag-offset-y = 0px;
                        } else if (event.kind == PointerEventKind.up) {
                            if (root.drag-node-index == index
                                    && (Math.abs(root.drag-offset-x) >= 3px
                                        || Math.abs(root.drag-offset-y) >= 3px)) {
                                root.node-moved(
                                    node.node-id,
                                    node.x + root.drag-offset-x / 1px,
                                    node.y + root.drag-offset-y / 1px,
                                );
                            } else if (root.drag-node-index == index) {
                                root.node-selected(node.node-id);
                            }
                            root.drag-node-index = -1;
                            root.drag-offset-x = 0px;
                            root.drag-offset-y = 0px;
                        }
                    }

                    moved => {
                        if (self.pressed && root.drag-node-index == index) {
                            root.drag-offset-x = self.mouse-x - self.pressed-x;
                            root.drag-offset-y = self.mouse-y - self.pressed-y;
                        }
                    }

                    Rectangle {
                        private property <bool> highlighted: root.drag-node-index >= 0 ? root.drag-node-index == index : node.selected;
                        x: root.drag-node-index == index ? root.drag-offset-x : 0px;
                        y: root.drag-node-index == index ? root.drag-offset-y : 0px;
                        width: parent.width;
                        height: parent.height;
                        background: self.highlighted ? #263f56 : Theme.card;
                        border-color: self.highlighted ? Theme.accent : Theme.border;
                        border-width: self.highlighted ? 2px : 1px;
                        border-radius: 7px;

                        Text {
                            x: 10px; y: 8px; width: parent.width - 20px; height: 22px;
                            text: node.label;
                            color: Theme.accent;
                            font-size: 15px;
                            overflow: elide;
                        }
                        Text {
                            x: 10px; y: 32px; width: parent.width - 20px; height: 18px;
                            text: node.kind;
                            color: Theme.secondary;
                            font-size: 12px;
                            overflow: elide;
                        }
                        for port in node.ports: port-area := TouchArea {
                            x: port.output ? parent.width / 2 : 0px;
                            y: port.y * 1px - 11px;
                            width: parent.width / 2;
                            height: 22px;
                            enabled: !root.busy;
                            accessible-role: button;
                            accessible-label: (port.output ? "Output " : "Input ") + node.label + " " + port.label;
                            clicked => { root.port-selected(node.node-id, port.port-id, port.output); }
                            Rectangle {
                                x: port.output ? parent.width - 5px : -5px;
                                y: 6px; width: 10px; height: 10px;
                                border-radius: 5px;
                                background: root.pending-node-id == node.node-id && root.pending-port-id == port.port-id ? Theme.accent : #89a9ce;
                            }
                            Text {
                                x: 8px; width: parent.width - 16px; height: parent.height;
                                text: port.label;
                                color: port-area.has-hover ? Theme.accent : Theme.foreground;
                                font-size: 10px;
                                vertical-alignment: center;
                                horizontal-alignment: port.output ? right : left;
                                overflow: elide;
                            }
                        }
                    }
                }

                if root.nodes.length == 0: Text {
                    width: parent.width;
                    height: parent.height;
                    text: "This project has an empty graph.";
                    color: Theme.secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
