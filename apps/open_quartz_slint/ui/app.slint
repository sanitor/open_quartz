import { Palette } from "std-widgets.slint";
import { Button, ComboBox } from "components/compact_widgets.slint";
import { Theme } from "theme.slint";
import { TopBar, FactoryEntry, FactoryGroup } from "components/top_bar.slint";
import { GraphView, GraphNode, GraphEdge, GraphPort } from "components/graph_view.slint";
import { Inspector, InspectorPort, InspectorUniform, InspectorFormField, InspectorFormGroup, InspectorOnnxRow } from "components/inspector.slint";
export { GraphNode, GraphEdge, GraphPort, InspectorPort, InspectorUniform, InspectorFormField, InspectorFormGroup, InspectorOnnxRow, FactoryEntry, FactoryGroup }

export component AppWindow inherits Window {
    title: root.project-name + " — OpenQuartz";
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 800px;
    min-height: 540px;
    background: Theme.background;
    default-font-size: 11px;
    init => { Palette.color-scheme = ColorScheme.light; }

    in property <string> project-name;
    in-out property <string> project-path;
    in property <string> io-status;
    in property <string> runtime-status;
    in property <[FactoryGroup]> factory-groups;
    in property <int> renderer-factory-index: -1;
    in property <string> playback-state: "stopped";
    callback project-action(string);
    callback rename-project(string);
    private property <length> sidebar-width: 320px;
    private property <length> sidebar-start-width;
    private property <bool> preview-expanded: true;
    in property <[GraphNode]> graph-nodes;
    in property <[GraphEdge]> graph-edges;
    in property <float> graph-content-width;
    in property <float> graph-content-height;
    in property <bool> inspector-shader-read-only;
    in property <[string]> inspector-shader-line-numbers;
    in property <[int]> inspector-shader-line-offsets;
    in property <[int]> inspector-shader-find-offsets;
    in property <[int]> inspector-shader-find-lengths;
    in-out property <string> inspector-shader-find-query;
    callback inspector-shader-find-requested(string);
    in property <float> graph-origin-x;
    in property <float> graph-origin-y;
    in property <bool> busy;
    in property <string> inspector-node-id;
    in property <bool> inspector-has-selection;
    in property <string> inspector-node-type;
    in property <string> inspector-selection-message;
    in property <bool> inspector-is-shader;
    in property <bool> inspector-supports-output-size;
    in property <bool> inspector-label-dirty;
    in property <bool> inspector-shader-dirty;
    in property <bool> inspector-output-size-dirty;
    in property <bool> inspector-dirty;
    in property <string> inspector-validation-message;
    in property <[InspectorPort]> inspector-ports;
    in property <[InspectorUniform]> inspector-uniforms;
    in property <bool> inspector-uniform-dirty;
    in property <bool> inspector-uniforms-valid: true;
    in property <[InspectorFormGroup]> inspector-forms;
    in property <[InspectorOnnxRow]> inspector-onnx-config;
    in property <[InspectorOnnxRow]> inspector-onnx-saved;
    in property <string> inspector-onnx-status;
    in property <[InspectorOnnxRow]> inspector-onnx-live;
    in property <bool> inspector-onnx-available;
    in property <bool> inspector-onnx-loading;
    in property <bool> inspector-onnx-attached;
    in-out property <string> inspector-onnx-path;
    callback inspector-load-onnx(string);
    in property <bool> inspector-image-input;
    in property <string> inspector-image-name;
    in property <string> inspector-image-size;
    in property <bool> inspector-framebuffer-input;
    in property <string> inspector-framebuffer-name;
    callback inspector-choose-image();
    in property <bool> inspector-video-input;
    in property <[string]> inspector-camera-options;
    in property <int> inspector-camera-index: -1;
    in property <bool> inspector-camera-loading;
    callback inspector-choose-video();
    callback inspector-refresh-cameras();
    callback inspector-select-camera(int);
    callback inspector-choose-framebuffer();
    callback inspector-unload-onnx();
    in-out property <string> inspector-node-label;
    in-out property <string> inspector-shader-code;
    in-out property <bool> inspector-auto-size;
    in-out property <int> inspector-output-width;
    in-out property <int> inspector-output-height;
    callback inspector-label-draft-changed(string);
    callback inspector-shader-draft-changed(string);
    callback inspector-output-size-draft-changed(int, int, bool);
    callback inspector-uniform-draft-changed(string, string);
    callback inspector-apply-label();
    callback inspector-apply-shader();
    callback inspector-apply-output-size();
    callback inspector-apply-uniforms();
    callback inspector-discard-drafts();
    callback inspector-form-draft-changed(string, string);
    callback inspector-apply-form(string);
    in property <image> renderer-image;
    in property <bool> has-renderer-image;
    in property <bool> inspector-has-preview;
    callback graph-node-selected(string, bool);
    callback graph-node-moved(string, float, float);
    in property <string> selected-edge-id;
    in property <string> pending-node-id;
    in property <string> pending-port-id;
    in property <bool> connection-active;
    in property <bool> can-undo;
    in property <bool> can-redo;
    callback graph-port-selected(string, string, bool);
    callback graph-edge-selected(string);
    callback graph-reconnect-edge();
    callback graph-delete-edge();
    callback graph-cancel-connection();
    callback graph-undo();
    callback graph-redo();
    callback reset-graph-view();
    reset-graph-view => { graph-view.reset-view(); }
    callback graph-begin-projection();
    callback graph-end-projection();
    graph-begin-projection => { graph-view.begin-projection(); }
    graph-end-projection => { graph-view.end-projection(); }
    in property <bool> can-copy;
    in property <bool> can-paste;
    in property <int> graph-selection-count;
    callback graph-copy();
    callback graph-paste();
    callback graph-add-node(int);
    callback graph-remove-nodes();
    callback graph-select-all();
    callback graph-toggle-preview(string);
    in property <[string]> renderer-options;
    in property <int> renderer-index: -1;
    in property <bool> native-runtime-available;
    in property <bool> screen-saver-available;
    callback select-renderer(int);
    callback capture-png();
    callback export-screen-saver();
    callback playback(string);
    in-out property <bool> preview-open;
    callback preview-requested(bool);
    changed preview-open => {
        if root.preview-open { preview-focus.focus(); } else { graph-view.focus(); }
    }

    VerticalLayout {
        padding: 0px;
        spacing: 0px;
        TopBar {
            project-name: root.project-name;
            runtime-status: root.runtime-status;
            io-status: root.io-status;
            busy: root.busy || root.inspector-dirty;
            can-undo: root.can-undo;
            can-redo: root.can-redo;
            factory-groups: root.factory-groups;
            renderer-factory-index: root.renderer-factory-index;
            playback-state: root.playback-state;
            native-runtime-available: root.native-runtime-available;
            screen-saver-available: root.screen-saver-available;
            export-selection-valid: root.renderer-index >= 0 && root.graph-selection-count <= 1;
            project-action(action) => { root.project-action(action); }
            rename-project(name) => { root.rename-project(name); }
            add-node(index) => { root.graph-add-node(index); }
            undo => { root.graph-undo(); }
            redo => { root.graph-redo(); }
            capture-png => { root.capture-png(); }
            export-screen-saver => { root.export-screen-saver(); }
            playback(action) => { root.playback(action); }
        }
        HorizontalLayout {
            spacing: 0px;
            graph-view := GraphView {
                nodes: root.graph-nodes;
                edges: root.graph-edges;
                content-width: root.graph-content-width;
                content-height: root.graph-content-height;
                origin-x: root.graph-origin-x;
                origin-y: root.graph-origin-y;
                busy: root.busy || root.inspector-dirty;
                node-selected(node-id, additive) => { root.graph-node-selected(node-id, additive); }
                node-moved(node-id, x, y) => { root.graph-node-moved(node-id, x, y); }
                selected-edge-id: root.selected-edge-id;
                pending-node-id: root.pending-node-id;
                pending-port-id: root.pending-port-id;
                connection-active: root.connection-active;
                can-undo: root.can-undo;
                can-redo: root.can-redo;
                port-selected(node-id, port-id, output) => { root.graph-port-selected(node-id, port-id, output); }
                edge-selected(edge-id) => { root.graph-edge-selected(edge-id); }
                reconnect-edge => { root.graph-reconnect-edge(); }
                delete-edge => { root.graph-delete-edge(); }
                cancel-connection => { root.graph-cancel-connection(); }
                undo => { root.graph-undo(); }
                redo => { root.graph-redo(); }
                can-copy: root.can-copy;
                can-paste: root.can-paste;
                selection-count: root.graph-selection-count;
                copy => { root.graph-copy(); }
                paste => { root.graph-paste(); }
                select-all => { root.graph-select-all(); }
                remove-nodes => { root.graph-remove-nodes(); }
                toggle-preview(node-id) => { root.graph-toggle-preview(node-id); }
                horizontal-stretch: 1;
                vertical-stretch: 1;
            }
            if root.inspector-has-selection || root.graph-selection-count > 1: Rectangle {
                width: root.sidebar-width;
                background: Theme.panel;
                Rectangle { width: 1px; height: parent.height; background: #d2d2d7; }
                VerticalLayout {
                    padding-left: 1px;
                    spacing: 0px;
                Inspector {
                    node-id: root.inspector-node-id;
                    has-selection: root.inspector-has-selection;
                    node-type: root.inspector-node-type;
                    shader-read-only: root.inspector-shader-read-only;
                    shader-line-numbers: root.inspector-shader-line-numbers;
                    shader-line-offsets: root.inspector-shader-line-offsets;
                    shader-find-offsets: root.inspector-shader-find-offsets;
                    shader-find-lengths: root.inspector-shader-find-lengths;
                    shader-find-query <=> root.inspector-shader-find-query;
                    shader-find-requested(query) => { root.inspector-shader-find-requested(query); }
                    selection-message: root.inspector-selection-message;
                    project-busy: root.busy;
                    is-shader: root.inspector-is-shader;
                    supports-output-size: root.inspector-supports-output-size;
                    label-dirty: root.inspector-label-dirty;
                    shader-dirty: root.inspector-shader-dirty;
                    output-size-dirty: root.inspector-output-size-dirty;
                    uniform-dirty: root.inspector-uniform-dirty;
                    inspector-dirty: root.inspector-dirty;
                    validation-message: root.inspector-validation-message;
                    uniforms-valid: root.inspector-uniforms-valid;
                    ports: root.inspector-ports;
                    uniforms: root.inspector-uniforms;
                    forms: root.inspector-forms;
                    onnx-config: root.inspector-onnx-config;
                    onnx-saved: root.inspector-onnx-saved;
                    onnx-status: root.inspector-onnx-status;
                    onnx-live: root.inspector-onnx-live;
                    onnx-available: root.inspector-onnx-available;
                    onnx-loading: root.inspector-onnx-loading;
                    onnx-attached: root.inspector-onnx-attached;
                    onnx-path <=> root.inspector-onnx-path;
                    load-onnx(path) => { root.inspector-load-onnx(path); }
                    image-input: root.inspector-image-input;
                    image-name: root.inspector-image-name;
                    image-size: root.inspector-image-size;
                    framebuffer-input: root.inspector-framebuffer-input;
                    framebuffer-name: root.inspector-framebuffer-name;
                    choose-image => { root.inspector-choose-image(); }
                    choose-framebuffer => { root.inspector-choose-framebuffer(); }
                    video-input: root.inspector-video-input;
                    camera-options: root.inspector-camera-options;
                    camera-index: root.inspector-camera-index;
                    camera-loading: root.inspector-camera-loading;
                    choose-video => { root.inspector-choose-video(); }
                    refresh-cameras => { root.inspector-refresh-cameras(); }
                    select-camera(index) => { root.inspector-select-camera(index); }
                    unload-onnx => { root.inspector-unload-onnx(); }
                    node-label <=> root.inspector-node-label;
                    shader-code <=> root.inspector-shader-code;
                    auto-size <=> root.inspector-auto-size;
                    output-width <=> root.inspector-output-width;
                    output-height <=> root.inspector-output-height;
                    label-draft-changed(text) => { root.inspector-label-draft-changed(text); }
                    shader-draft-changed(text) => { root.inspector-shader-draft-changed(text); }
                    output-size-draft-changed(width, height, auto) => { root.inspector-output-size-draft-changed(width, height, auto); }
                    uniform-draft-changed(label, value) => { root.inspector-uniform-draft-changed(label, value); }
                    apply-label => { root.inspector-apply-label(); }
                    apply-shader => { root.inspector-apply-shader(); }
                    apply-output-size => { root.inspector-apply-output-size(); }
                    apply-uniforms => { root.inspector-apply-uniforms(); }
                    discard-drafts => { root.inspector-discard-drafts(); }
                    form-draft-changed(key, value) => { root.inspector-form-draft-changed(key, value); }
                    delete-node => { root.graph-remove-nodes(); }
                    apply-form(key) => { root.inspector-apply-form(key); }
                    horizontal-stretch: 1;
                    preferred-height: root.inspector-node-type == "Shader" ? 400px : root.inspector-node-type == "Renderer" ? 116px : 0px;
                    vertical-stretch: root.inspector-node-type == "Renderer" ? 0 : 1;
                    min-height: root.inspector-node-type == "Shader" ? 280px : 0px;
                }
                if root.inspector-has-selection && root.inspector-has-preview: Rectangle {
                    background: Theme.card;
                    min-height: root.preview-expanded ? 180px : 30px;
                    preferred-height: 0px;
                    vertical-stretch: root.preview-expanded ? 2 : 0;
                    VerticalLayout {
                        spacing: 0px;
                        Rectangle {
                            height: 30px;
                            background: Theme.panel;
                            Rectangle { x: 0px; y: 0px; height: 1px; width: parent.width; background: Theme.border; }
                            Text { x: 16px; height: parent.height; text: (root.preview-expanded ? "▾" : "▸") + "  PREVIEW"; font-size: 11px; color: Theme.secondary; vertical-alignment: center; }
                            TouchArea { clicked => { root.preview-expanded = !root.preview-expanded; } }
                        }
                        if root.preview-expanded: HorizontalLayout {
                            padding: 8px; spacing: 4px;
                            Text { text: root.inspector-node-label; color: Theme.secondary; font-size: 10px; horizontal-stretch: 1; overflow: elide; }
                            Button { text: "Fullscreen"; accessible-label: "Fullscreen preview"; enabled: root.has-renderer-image; clicked => { root.preview-requested(true); } }
                        }
                        if root.preview-expanded: Rectangle {
                            horizontal-stretch: 1;
                            vertical-stretch: 1;
                            Image { width: parent.width; height: parent.height; source: root.renderer-image; image-fit: contain; }
                            if !root.has-renderer-image: Text { width: parent.width; height: parent.height; text: "No renderer image"; font-size: 12px; color: #aeaeb2; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { enabled: root.has-renderer-image; double-clicked => { root.preview-requested(true); } }
                        }
                    }
                }
                }
                resize-area := TouchArea {
                    width: 4px; height: parent.height;
                    mouse-cursor: ew-resize;
                    pointer-event(event) => { if event.kind == PointerEventKind.down { root.sidebar-start-width = root.sidebar-width; } }
                    moved => { if self.pressed { root.sidebar-width = clamp(root.sidebar-start-width + self.pressed-x - self.mouse-x, 240px, min(640px, root.width - 400px)); } }
                }
            }
        }
    }
    preview-focus := FocusScope {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        visible: root.preview-open;
        key-pressed(event) => {
            if root.preview-open && event.text == Key.Escape {
                root.preview-requested(false);
                return accept;
            }
            return reject;
        }
        Rectangle { width: parent.width; height: parent.height; background: #111111; }
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            HorizontalLayout {
                Text { text: root.inspector-node-label + " · Preview"; color: white; font-size: 14px; horizontal-stretch: 1; }
                Button { text: "Close · Esc"; clicked => { root.preview-requested(false); } }
            }
            Image { source: root.renderer-image; image-fit: contain; horizontal-stretch: 1; vertical-stretch: 1; }
            Text { text: root.runtime-status; color: Theme.secondary; wrap: word-wrap; }
        }
    }
}
