export global Theme {
    out property <color> background: #ffffff;
    out property <color> panel: #ffffff;
    out property <color> card: #f5f5f7;
    out property <color> border: #e8e8ed;
    out property <color> foreground: #1d1d1f;
    out property <color> secondary: #86868b;
    out property <color> accent: #007aff;
}
