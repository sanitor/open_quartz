export global Theme {
    in-out property <bool> dark: false;
    out property <color> background: Theme.dark ? #15181b : #ffffff;
    out property <color> panel: Theme.dark ? #1b1e21 : #ffffff;
    out property <color> card: Theme.dark ? #252a2f : #f5f5f7;
    out property <color> border: Theme.dark ? #30363b : #e8e8ed;
    out property <color> foreground: Theme.dark ? #e7eaed : #1d1d1f;
    out property <color> secondary: Theme.dark ? #9ba5ad : #86868b;
    out property <color> accent: Theme.dark ? #38d9c3 : #007aff;
    out property <color> graph-background: Theme.dark ? #15181b : #e0e0e0;
    out property <color> graph-node: Theme.dark ? #20252a : #ffffff;
    out property <color> graph-node-border: Theme.dark ? #3b454f : #d2d2d7;
    out property <color> graph-active: Theme.dark ? #20433f : #e8f2ff;
    out property <color> graph-overlay: Theme.dark ? #20252af5 : #ffffffed;
}
