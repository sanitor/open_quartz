import { Button, LineEdit, Palette, ScrollView } from "std-widgets.slint";
import { WindowControls } from "../../open_quartz_slint/ui/components/window_controls.slint";
import { ToolButton } from "icon_button.slint";
import { GraphView, GraphNode, GraphEdge, GraphPort } from "../../open_quartz_slint/ui/components/graph_view.slint";
import { Inspector, InspectorPort, InspectorUniform, InspectorFormField, InspectorFormGroup } from "../../open_quartz_slint/ui/components/inspector.slint";
import { Theme } from "../../open_quartz_slint/ui/theme.slint";
import { CodeEditorBridge } from "code_editor.slint";
export { CodeEditorBridge, GraphNode, GraphEdge, GraphPort, InspectorPort, InspectorUniform, InspectorFormField, InspectorFormGroup }

export struct PipelineEffect { label: string, index: int }

export struct AssetRow { id: string, name: string, details: string, online: bool, selected: bool, thumbnail: image, has_thumbnail: bool }
export struct ClipRow { id: string, asset_name: string, start: int, duration: int, x: float, width: float, selected: bool, online: bool, thumbnail: image, has_thumbnail: bool }


component AssetCard inherits Rectangle {
    in property <AssetRow> asset;
    callback clicked();
    callback add_clicked(string);
    height: 76px; background: root.asset.selected ? #29363a : #202427; border-radius: 6px;
    accessible-role: button;
    accessible-label: root.asset.name;
    accessible-description: root.asset.details + (root.asset.online ? "; online" : "; offline");
    Rectangle {
        x: 7px; y: 8px; width: 88px; height: 60px; background: #101214; border-radius: 4px; clip: true;
        if root.asset.has_thumbnail: Image { width: parent.width; height: parent.height; source: root.asset.thumbnail; image-fit: cover; }
        if !root.asset.has_thumbnail: Text { text: root.asset.online ? "▶" : "!"; color: root.asset.online ? #5bdcc9 : #ff7373; font-size: 20px; horizontal-alignment: center; vertical-alignment: center; }
    }
    Text { x: 102px; y: 7px; width: parent.width - 136px; height: 18px; text: root.asset.name; color: root.asset.online ? #e4e8eb : #ff7373; font-size: 12px; font-weight: 600; overflow: elide; }
    Text { x: 102px; y: 27px; width: parent.width - 136px; height: 30px; text: root.asset.details; color: #8e979d; font-size: 11px; wrap: word-wrap; overflow: elide; }
    Text { x: 102px; y: 58px; width: 100px; height: 16px; text: root.asset.online ? "● Ready" : "● Offline"; color: root.asset.online ? #49cba9 : #fa7373; font-size: 11px; }
    TouchArea { width: parent.width - 30px; height: parent.height; clicked => { root.clicked(); } }
    Text { x: parent.width - 28px; y: 25px; width: 24px; height: 24px; text: "+"; color: #38d9c3; font-size: 20px; horizontal-alignment: center; vertical-alignment: center; }
    TouchArea { x: parent.width - 30px; width: 30px; height: parent.height; accessible-role: button; accessible-label: "Add " + root.asset.name + " to timeline"; clicked => { root.add_clicked(root.asset.id); } }
}

// Capture absolute pointer coordinates so moving the preview under the pointer
// cannot feed its own displacement back into the gesture. Only release commits.
component ClipGestureArea inherits TouchArea {
    in property <float> zoom: 16;
    in property <int> cancel_token;
    callback began();
    callback preview(int);
    callback finished(int);
    callback cancelled();
    private property <bool> armed: false;
    private property <length> origin_x;
    changed cancel_token => { self.armed = false; root.cancelled(); }
    pointer-event(event) => {
        if event.kind == PointerEventKind.cancel {
            self.armed = false;
            root.cancelled();
        } else if event.button == PointerEventButton.left {
            if event.kind == PointerEventKind.down {
                self.origin_x = self.absolute-position.x + self.mouse-x;
                self.armed = true;
                root.began();
            } else if event.kind == PointerEventKind.up && self.armed {
                self.armed = false;
                root.finished(Math.round((self.absolute-position.x + self.mouse-x - self.origin_x) / 1px / max(0.0001, root.zoom)));
            }
        }
    }
    moved => {
        if self.pressed && self.armed {
            root.preview(Math.round((self.absolute-position.x + self.mouse-x - self.origin_x) / 1px / max(0.0001, root.zoom)));
        }
    }
}

component TimelineClip inherits Rectangle {
    in property <ClipRow> item;
    in property <float> zoom: 16;
    in property <int> cancel_token;
    callback clicked();
    callback focused();
    callback gesture(string, int);
    private property <string> gesture_kind: "";
    private property <int> delta: 0;
    function bounded_delta(kind: string, value: int) -> int {
        if kind == "move" { return max(-root.item.start, value); }
        if kind == "trim-start" { return clamp(value, -root.item.start, root.item.duration - 1); }
        return max(1 - root.item.duration, value);
    }
    function finish(kind: string, value: int) {
        let result = root.bounded_delta(kind, value);
        root.delta = 0;
        root.gesture_kind = "";
        root.clicked();
        if result != 0 { root.gesture(kind, result); }
    }
    x: 10px + (root.item.x + (root.gesture_kind == "move" || root.gesture_kind == "trim-start" ? root.delta * root.zoom : 0)) * 1px;
    y: 52px;
    width: max(2px, (root.item.width + (root.gesture_kind == "trim-end" ? root.delta * root.zoom : root.gesture_kind == "trim-start" ? -root.delta * root.zoom : 0)) * 1px);
    height: 72px;
    background: root.item.selected || root.gesture_kind != "" ? #265d59 : root.item.online ? #284844 : #633a3b;
    border-color: root.item.selected || root.gesture_kind != "" ? #49d8c6 : #32786f;
    border-width: root.item.selected ? 2px : 1px; border-radius: 5px;
    accessible-role: button;
    accessible-label: root.item.asset_name;
    accessible-description: "Timeline start " + root.item.start + " frames; duration " + root.item.duration + " frames";
    // A rounded clip in FemtoVG allocates an offscreen target for the whole
    // timeline item, which can exceed the GPU texture limit for ordinary media.
    // Keep the rounded shell, but scissor its contents with a square inset.
    Rectangle {
        x: 2px; y: 2px; width: max(0px, parent.width - 4px); height: parent.height - 4px;
        clip: true;
        if root.item.has_thumbnail: Image { x: 5px; y: 21px; width: min(78px, max(0px, parent.width - 10px)); height: 43px; source: root.item.thumbnail; image-fit: cover; opacity: 0.8; }
        Text { x: 7px; y: 3px; width: max(0px, parent.width - 14px); height: 16px; text: root.item.asset_name; color: #effffb; font-size: 12px; font-weight: 600; overflow: elide; }
        Text { x: root.item.has_thumbnail ? 88px : 7px; y: 28px; width: max(0px, parent.width - self.x - 7px); height: 32px; text: (root.item.start + (root.gesture_kind == "move" || root.gesture_kind == "trim-start" ? root.delta : 0)) + "f\n" + root.item.duration + "f source clip"; color: #c0dbd6; font-size: 11px; }
    }
    ClipGestureArea {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        zoom: root.zoom; cancel_token: root.cancel_token;
        began => { root.focused(); root.gesture_kind = "move"; root.delta = 0; }
        preview(value) => { root.delta = root.bounded_delta("move", value); }
        finished(value) => { root.finish("move", value); }
        cancelled => { root.gesture_kind = ""; root.delta = 0; }
    }
    Rectangle { x: 2px; y: 24px; width: 3px; height: 24px; background: #86c9bd; border-radius: 1px; }
    Rectangle { x: parent.width - 5px; y: 24px; width: 3px; height: 24px; background: #86c9bd; border-radius: 1px; }
    ClipGestureArea {
        x: 0px; y: 0px;
        width: min(9px, parent.width / 3); height: parent.height; zoom: root.zoom; cancel_token: root.cancel_token; mouse-cursor: ew-resize;
        accessible-role: button;
        accessible-label: "Trim start of " + root.item.asset_name;
        began => { root.focused(); root.gesture_kind = "trim-start"; root.delta = 0; }
        preview(value) => { root.delta = root.bounded_delta("trim-start", value); }
        finished(value) => { root.finish("trim-start", value); }
        cancelled => { root.gesture_kind = ""; root.delta = 0; }
    }
    ClipGestureArea {
        x: parent.width - self.width; width: min(9px, parent.width / 3); height: parent.height; zoom: root.zoom; cancel_token: root.cancel_token; mouse-cursor: ew-resize;
        accessible-role: button;
        accessible-label: "Trim end of " + root.item.asset_name;
        began => { root.focused(); root.gesture_kind = "trim-end"; root.delta = 0; }
        preview(value) => { root.delta = root.bounded_delta("trim-end", value); }
        finished(value) => { root.finish("trim-end", value); }
        cancelled => { root.gesture_kind = ""; root.delta = 0; }
    }
}

component TimingField inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> enabled: true;
    callback committed(string);
    spacing: 4px;
    Text { text: root.label; color: #939ba2; font-size: 12px; }
    LineEdit { accessible-label: root.label; enabled: root.enabled; text: root.value; placeholder-text: "Enter value"; accepted(value) => { root.committed(value); } }
}

export component EditorWindow inherits Window {
    no-frame: true;
    resize-border-width: root.maximized ? 0px : 6px;
    in property <bool> window-controls-on-left;
    in property <bool> mac-style-controls;
    title: "OpenQuartz Studio — " + root.project_name;
    preferred-width: 1440px; preferred-height: 900px; min-width: 1040px; min-height: 700px;
    background: #111315; default-font-size: 12px;
    accessible-role: main;
    accessible-label: "OpenQuartz video editor";
    accessible-description: "Project " + root.project_name + "; assets " + root.assets.length + "; clips " + root.clips.length + "; playhead " + root.selected_frame + " frames, " + root.timecode + "; " + root.project_status + "; " + root.io_status;
    forward-focus: editor_focus;
    init => { Palette.color-scheme = ColorScheme.dark; Theme.dark = true; }
    in-out property <string> project_name: "Untitled Video";
    in-out property <string> project_path: "Not saved";
    in-out property <string> project_status: "Hardware GPU initializing";
    in-out property <string> io_status: "All changes saved";
    in property <[AssetRow]> assets;
    in property <[ClipRow]> clips;
    in property <int> selected_frame: 0;
    in property <int> sequence_duration: 0;
    in property <string> timecode: "00:00:00:00";
    in property <string> sequence_timecode: "00:00:00:00";
    in property <string> sequence_fps: "30";
    in property <image> monitor_image;
    in property <bool> has_monitor_image: false;
    in property <bool> playing: false;
    in property <bool> can_undo: false;
    in property <bool> can_redo: false;
    in property <string> selected_asset_name: "No media selected";
    in property <string> selected_asset_details: "Import a local H.264 or HEVC clip";
    in property <string> selected_clip_name: "No clip selected";
    in property <string> selected_clip_start: "0";
    in property <string> selected_clip_duration: "0";
    in property <string> selected_clip_end: "0";
    in property <string> selected_clip_source_in: "0";
    in property <string> selected_clip_source_out: "0";
    in property <string> selected_clip_id: "";
    in-out property <float> timeline_zoom: 16;
    in-out property <string> search_query;
    in-out property <string> file_path;
    in-out property <string> file_dialog_kind;
    in-out property <bool> file_dialog_open: false;
    in property <string> selected_clip_scale: "1.0";
    in property <string> selected_clip_x: "0.0";
    in property <string> selected_clip_y: "0.0";
    in property <string> selected_clip_exposure: "0.0";
    in property <int> project_data_width: 1920;
    in property <int> project_data_height: 1080;
    in property <string> sequence_fps_numerator: "30";
    in property <string> sequence_fps_denominator: "1";
    in property <float> timeline_content_width: 900;
    in-out property <bool> nodes_open: false;
    callback nodes_workspace_changed(bool);
    in property <[GraphNode]> pipeline_nodes;
    in property <[GraphEdge]> pipeline_edges;
    in property <float> pipeline_content_width;
    in property <float> pipeline_content_height;
    in property <float> pipeline_origin_x;
    in property <float> pipeline_origin_y;
    in property <bool> pipeline_busy;
    in property <string> pipeline_selected_edge_id;
    in property <string> pipeline_pending_node_id;
    in property <string> pipeline_pending_port_id;
    in property <bool> pipeline_connection_active;
    in property <bool> pipeline_can_copy;
    in property <bool> pipeline_can_paste;
    in property <int> pipeline_selection_count;
    in property <[PipelineEffect]> pipeline_effects;
    in property <string> pipeline_error;
    in property <string> pipeline_node_id;
    in property <string> pipeline_node_type;
    in property <string> pipeline_selection_message;
    in property <bool> pipeline_has_selection;
    in property <bool> pipeline_is_shader;
    in property <bool> pipeline_supports_output_size;
    in property <bool> pipeline_label_read_only;
    in property <bool> pipeline_shader_read_only;
    in property <bool> pipeline_can_delete;
    in property <bool> pipeline_label_dirty;
    in property <bool> pipeline_shader_dirty;
    in property <bool> pipeline_output_size_dirty;
    in property <bool> pipeline_uniform_dirty;
    in property <bool> pipeline_inspector_dirty;
    in property <string> pipeline_validation_message;
    in property <bool> pipeline_uniforms_valid: true;
    in property <[InspectorPort]> pipeline_ports;
    in property <[InspectorUniform]> pipeline_uniforms;
    in property <[InspectorFormGroup]> pipeline_forms;
    in-out property <string> pipeline_node_label;
    in-out property <string> pipeline_shader_code;
    in-out property <bool> pipeline_auto_size;
    in-out property <int> pipeline_output_width;
    in-out property <int> pipeline_output_height;
    callback pipeline_node_selected(string, bool);
    callback pipeline_node_moved(string, float, float);
    callback pipeline_port_selected(string, string, bool);
    callback pipeline_port_dropped(string, string, bool, float, float, float);
    callback pipeline_edge_selected(string);
    callback pipeline_add_effect(int);
    callback pipeline_action(string);
    callback pipeline_label_draft_changed(string);
    callback pipeline_shader_draft_changed(string);
    callback pipeline_output_size_draft_changed(int, int, bool);
    callback pipeline_uniform_draft_changed(string, string);
    callback pipeline_form_draft_changed(string, string);
    callback pipeline_apply_form(string);
    callback project_action(string);
    callback import_media(); callback asset_select(string); callback add_to_timeline();
    callback clip_select(string); callback split_clip(); callback lift_clip();
    callback trim_clip(string, int); callback undo(); callback redo();
    callback playback(string); callback step_frame(int); callback zoom_changed(float);
    callback seek_frame(int);
    callback clip_gesture(id: string, kind: string, delta: int);
    callback add_asset_to_timeline(string);
    callback shortcut(string);
    callback search_changed(string);
    callback clip_timing_changed(field: string, value: string);
    callback sequence_settings(width: string, height: string, fps_numerator: string, fps_denominator: string);
    callback rename_project(string);
    callback file_submit(kind: string, path: string);
    function submit_file() {
        let kind = root.file_dialog_kind;
        let path = root.file_path;
        root.file_dialog_open = false;
        editor_focus.focus();
        root.file_submit(kind, path);
    }
    private property <bool> settings_open: false;
    private property <string> draft_width;
    private property <string> draft_height;
    private property <string> draft_fps_numerator;
    private property <string> draft_fps_denominator;
    function open_settings() {
        root.draft_width = root.project_data_width + "";
        root.draft_height = root.project_data_height + "";
        root.draft_fps_numerator = root.sequence_fps_numerator;
        root.draft_fps_denominator = root.sequence_fps_denominator;
        root.settings_open = true;
        root.cancel_token += 1;
        root.project_action("settings");
    }
    private property <int> cancel_token: 0;
    private property <int> ruler_step: max(1, Math.ceil(100 / max(0.0001, root.timeline_zoom)));
    function set_zoom(value: float) {
        let anchor = -timeline_scroll.content-x / 1px / max(0.0001, root.timeline_zoom);
        root.cancel_token += 1;
        root.timeline_zoom = clamp(value, 0.0001, 48);
        root.zoom_changed(root.timeline_zoom);
        timeline_scroll.content-x = min(0px, -anchor * root.timeline_zoom * 1px);
    }
    function fit_timeline() {
        root.set_zoom((timeline_scroll.visible-width / 1px - 32) / max(1, root.sequence_duration));
        timeline_scroll.content-x = 0px;
    }
    function ruler_label(frame: int) -> string {
        if root.timeline_zoom >= 4 { return frame + "f"; }
        let seconds = Math.round(frame * root.sequence_fps_denominator.to-float() / max(1, root.sequence_fps_numerator.to-float()));
        if seconds < 60 { return seconds + "s"; }
        let minutes = Math.floor(seconds / 60);
        let remainder = Math.mod(seconds, 60);
        return minutes + ":" + (remainder < 10 ? "0" : "") + remainder;
    }
    private property <color> panel: #1b1e21;
    private property <color> border: #30363b;
    private property <color> text: #e7eaed;
    private property <color> secondary: #939ba2;
    private property <color> accent: #38d9c3;

    editor_focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.settings_open = false;
                root.file_dialog_open = false;
                root.cancel_token += 1;
                if root.nodes_open { root.pipeline_action("cancel-connection"); }
                root.shortcut("cancel");
                return accept;
            }
            if root.settings_open || root.file_dialog_open { return reject; }
            // Command is represented as control by Slint on macOS.
            if event.modifiers.control && !event.modifiers.alt {
                if root.nodes_open && !event.modifiers.shift {
                    if event.text == "c" || event.text == "C" { if root.pipeline_can_copy { root.pipeline_action("copy"); } return accept; }
                    if event.text == "v" || event.text == "V" { if root.pipeline_can_paste { root.pipeline_action("paste"); } return accept; }
                    if event.text == "a" || event.text == "A" { root.pipeline_action("select-all"); return accept; }
                }
                if event.text == "n" || event.text == "N" { root.shortcut("new"); return accept; }
                if event.text == "o" || event.text == "O" { root.shortcut("open"); return accept; }
                if event.text == "s" || event.text == "S" { root.shortcut(event.modifiers.shift ? "save-as" : "save"); return accept; }
                if event.text == "i" || event.text == "I" { root.shortcut("import"); return accept; }
                if event.text == "r" || event.text == "R" { root.shortcut("relink"); return accept; }
                if event.text == "z" || event.text == "Z" { root.shortcut(event.modifiers.shift ? "redo" : "undo"); return accept; }
                if event.text == "y" || event.text == "Y" { root.shortcut("redo"); return accept; }
                if event.text == "b" || event.text == "B" { root.shortcut("split"); return accept; }
            }
            if !event.modifiers.control && !event.modifiers.alt {
                if event.text == " " { root.shortcut("play"); return accept; }
                if event.text == Key.LeftArrow { root.shortcut("step-back"); return accept; }
                if event.text == Key.RightArrow { root.shortcut("step-forward"); return accept; }
                if event.text == Key.Delete || event.text == Key.Backspace {
                    if root.nodes_open { root.pipeline_action(root.pipeline_selected_edge_id != "" ? "delete-edge" : "remove-nodes"); }
                    else { root.shortcut("delete"); }
                    return accept;
                }
            }
            reject
        }
        VerticalLayout {
            spacing: 0px;
            Rectangle {
                height: 56px; background: #181a1c;
                WindowMoveArea {
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px; spacing: 16px;
                        cross-axis-alignment: center;
                        if root.window-controls-on-left: WindowControls {
                            mac-style: root.mac-style-controls; maximized: root.maximized;
                            foreground: root.text; hover-background: #303438;
                            minimize-window => { root.minimized = true; }
                            toggle-maximize-window => { root.maximized = !root.maximized; }
                            close-window => { root.close(); }
                        }
                        Rectangle {
                            width: 28px; height: 28px; border-radius: 7px; background: root.accent;
                            Text { width: parent.width; height: parent.height; text: "Q"; color: #111719; font-size: 18px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { text: "OPENQUARTZ STUDIO"; color: root.text; font-size: 18px; font-weight: 700; vertical-alignment: center; }
                        Rectangle { width: 1px; height: 24px; background: root.border; }
                        LineEdit { height: 32px; width: 240px; accessible-label: "Project name"; text: root.project_name; placeholder-text: "Project name"; accepted(value) => { root.rename_project(value); } }
                        Rectangle {
                            width: 62px; height: 30px; border-radius: 5px;
                            background: !root.nodes_open ? #265d59 : edit_tab.has-hover ? #303438 : transparent;
                            border-width: 1px; border-color: !root.nodes_open ? root.accent : root.border;
                            Text { width: parent.width; height: parent.height; text: "Edit"; color: !root.nodes_open ? root.accent : root.text; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                            edit_tab := TouchArea {
                                accessible-role: button; accessible-label: "Edit workspace";
                                clicked => { editor_focus.focus(); root.nodes_open = false; root.nodes_workspace_changed(false); }
                            }
                        }
                        Rectangle {
                            width: 70px; height: 30px; border-radius: 5px;
                            background: root.nodes_open ? #265d59 : nodes_tab.has-hover ? #303438 : transparent;
                            border-width: 1px; border-color: root.nodes_open ? root.accent : root.border;
                            Text { width: parent.width; height: parent.height; text: "Nodes"; color: root.nodes_open ? root.accent : root.text; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                            nodes_tab := TouchArea {
                                accessible-role: button; accessible-label: "Nodes workspace";
                                clicked => { editor_focus.focus(); root.nodes_open = true; root.nodes_workspace_changed(true); }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        ToolButton { label: "UNDO"; glyph: "↶"; active: root.can_undo; clicked => { editor_focus.focus(); root.undo(); } }
                        ToolButton { label: "REDO"; glyph: "↷"; active: root.can_redo; clicked => { editor_focus.focus(); root.redo(); } }
                        if !root.window-controls-on-left: WindowControls {
                            mac-style: root.mac-style-controls; maximized: root.maximized;
                            foreground: root.text; hover-background: #303438;
                            minimize-window => { root.minimized = true; }
                            toggle-maximize-window => { root.maximized = !root.maximized; }
                            close-window => { root.close(); }
                        }
                    }
                }
            }
            Rectangle {
                height: 44px; background: #202326;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 16px; spacing: 8px; cross-axis-alignment: center;
                    ToolButton { label: "NEW"; glyph: "+"; clicked => { root.project_action("new"); } }
                    ToolButton { label: "OPEN"; glyph: "▱"; clicked => { root.project_action("open"); } }
                    ToolButton { label: "SAVE"; glyph: "▣"; clicked => { root.project_action("save"); } }
                    ToolButton { label: "SAVE AS"; glyph: "▣+"; clicked => { root.project_action("save-as"); } }
                    ToolButton { label: "RELINK"; glyph: "↔"; clicked => { root.project_action("relink"); } }
                    ToolButton { label: "IMPORT"; glyph: "↓"; clicked => { root.project_action("import"); } }
                    ToolButton { label: "SEQUENCE"; glyph: "⚙"; clicked => { editor_focus.focus(); root.open_settings(); } }
                    Text { text: root.project_path; color: root.secondary; font-size: 11px; overflow: elide; horizontal-stretch: 1; }
                    Text { text: root.io_status; color: root.secondary; font-size: 11px; overflow: elide; max-width: 420px; }
                }
            }
            HorizontalLayout {
                spacing: 1px; vertical-stretch: 1;
                if !root.nodes_open: Rectangle {
                    width: 260px; background: root.panel;
                    VerticalLayout {
                        spacing: 0px;
                        HorizontalLayout { height: 44px; padding-left: 14px; padding-right: 12px; cross-axis-alignment: center; Text { text: "Media library"; color: root.text; font-size: 12px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; } ToolButton { label: "IMPORT"; glyph: "↓"; clicked => { root.project_action("import"); } } }
                        LineEdit { text <=> root.search_query; placeholder-text: "Search media"; edited(value) => { root.search_changed(value); } }
                        HorizontalLayout { height: 30px; padding-left: 14px; padding-right: 12px; Text { text: "Project media"; color: root.accent; font-size: 12px; font-weight: 600; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } Text { text: root.assets.length + " items"; color: root.secondary; font-size: 11px; vertical-alignment: center; } }
                        ScrollView {
                            horizontal-stretch: 1; vertical-stretch: 1;
                            VerticalLayout {
                                padding: 10px; spacing: 8px;
                                if root.assets.length == 0: Rectangle {
                                    height: 160px; background: #151719; border-radius: 8px;
                                    VerticalLayout {
                                        alignment: LayoutAlignment.center; padding: 12px; spacing: 8px;
                                        Text { text: root.search_query == "" ? "Your media library" : "No matching media"; color: root.text; font-size: 12px; font-weight: 650; horizontal-alignment: center; }
                                        Text { text: root.search_query == "" ? "Import local H.264 / HEVC clips" : "Try another search"; color: root.secondary; font-size: 11px; horizontal-alignment: center; }
                                        Button { text: "Import media"; primary: true; clicked => { root.project_action("import"); } }
                                    }
                                }
                                for asset in root.assets: AssetCard { asset: asset; clicked => { editor_focus.focus(); root.asset_select(asset.id); } add_clicked(id) => { editor_focus.focus(); root.add_asset_to_timeline(id); } }
                                Rectangle { vertical-stretch: 1; }
                            }
                        }
                        Rectangle { height: 80px; background: #151719; VerticalLayout { padding: 12px; spacing: 5px; Text { text: root.selected_asset_name; color: root.text; font-size: 12px; font-weight: 600; overflow: elide; } Text { text: root.selected_asset_details; color: root.secondary; font-size: 11px; wrap: word-wrap; } } }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1; background: #101213;
                    VerticalLayout {
                        spacing: 0px;
                        HorizontalLayout { height: 44px; padding-left: 14px; padding-right: 14px; Text { text: root.nodes_open ? "Final · " + root.selected_clip_name : "Preview"; color: root.text; font-size: 12px; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; } Text { text: root.project_data_width + " × " + root.project_data_height; color: root.secondary; font-size: 11px; vertical-alignment: center; } }
                        Rectangle {
                            horizontal-stretch: 1; vertical-stretch: 1; background: #0a0b0c;
                            accessible-role: image;
                            accessible-label: "Video preview";
                            if root.has_monitor_image: Image { width: parent.width; height: parent.height; source: root.monitor_image; image-fit: contain; }
                            if !root.has_monitor_image: VerticalLayout { alignment: LayoutAlignment.center; spacing: 8px; Text { text: "◩"; color: #444b50; font-size: 36px; horizontal-alignment: center; } Text { text: "Add media to the timeline"; color: #7c848a; font-size: 12px; horizontal-alignment: center; } }
                        }
                        Rectangle {
                            height: 52px; background: #191c1e;
                            HorizontalLayout {
                                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                width: 112px; height: 32px; spacing: 8px; cross-axis-alignment: center;
                                ToolButton { label: "PREVIOUS"; glyph: "|◀"; clicked => { editor_focus.focus(); root.step_frame(-1); } }
                                ToolButton { label: root.playing ? "PAUSE" : "PLAY"; glyph: root.playing ? "Ⅱ" : "▶"; selected: root.playing; clicked => { editor_focus.focus(); root.playback(root.playing ? "pause" : "play"); } }
                                ToolButton { label: "NEXT"; glyph: "▶|"; clicked => { editor_focus.focus(); root.step_frame(1); } }
                            }
                            HorizontalLayout {
                                x: parent.width - self.width - 12px; y: (parent.height - self.height) / 2;
                                width: 194px; height: 32px; spacing: 6px;
                                Text { text: root.timecode; accessible-label: "Current timecode"; color: root.accent; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                                Text { text: "/ " + root.sequence_timecode; accessible-label: "Sequence timecode"; color: root.secondary; font-size: 12px; vertical-alignment: center; }
                            }
                        }
                    }
                }
                if root.nodes_open: Rectangle {
                    horizontal-stretch: 1; min-width: 420px; background: root.panel;
                    VerticalLayout {
                        spacing: 0px;
                        HorizontalLayout {
                            height: 44px; padding-left: 14px; padding-right: 14px; spacing: 10px;
                            Text { text: "Clip pipeline"; color: root.accent; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                            Text { text: root.selected_clip_id == "" ? "Select a timeline clip" : root.selected_clip_name; color: root.secondary; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                        }
                        GraphView {
                            horizontal-stretch: 1; vertical-stretch: 1;
                            nodes: root.pipeline_nodes; edges: root.pipeline_edges;
                            content-width: root.pipeline_content_width; content-height: root.pipeline_content_height;
                            origin-x: root.pipeline_origin_x; origin-y: root.pipeline_origin_y;
                            busy: root.pipeline_busy || root.selected_clip_id == "";
                            node-previews-enabled: false;
                            selected-edge-id: root.pipeline_selected_edge_id;
                            pending-node-id: root.pipeline_pending_node_id;
                            pending-port-id: root.pipeline_pending_port_id;
                            connection-active: root.pipeline_connection_active;
                            can-undo: root.can_undo; can-redo: root.can_redo;
                            can-copy: root.pipeline_can_copy; can-paste: root.pipeline_can_paste;
                            selection-count: root.pipeline_selection_count;
                            node-selected(id, additive) => { root.pipeline_node_selected(id, additive); }
                            node-moved(id, x, y) => { root.pipeline_node_moved(id, x, y); }
                            port-selected(node, port, output) => { root.pipeline_port_selected(node, port, output); }
                            port-dropped(node, port, output, x, y, scale) => { root.pipeline_port_dropped(node, port, output, x, y, scale); }
                            edge-selected(id) => { root.pipeline_edge_selected(id); }
                            reconnect-edge => { root.pipeline_action("reconnect-edge"); }
                            delete-edge => { root.pipeline_action("delete-edge"); }
                            cancel-connection => { root.pipeline_action("cancel-connection"); }
                            undo => { root.undo(); } redo => { root.redo(); }
                            copy => { root.pipeline_action("copy"); }
                            paste => { root.pipeline_action("paste"); }
                            select-all => { root.pipeline_action("select-all"); }
                            remove-nodes => { root.pipeline_action("remove-nodes"); }
                            toggle-preview(id) => { root.pipeline_action("toggle-preview:" + id); }
                        }
                        if root.pipeline_error != "": Rectangle {
                            height: 44px; background: #43272b;
                            Text { x: 12px; width: parent.width - 24px; height: parent.height; text: root.pipeline_error; accessible-label: "Pipeline error"; color: #ffaaaa; font-size: 11px; wrap: word-wrap; overflow: elide; vertical-alignment: center; }
                        }
                    }
                }
                if !root.nodes_open: Rectangle {
                    width: 250px; background: root.panel;
                    VerticalLayout {
                        spacing: 0px;
                        HorizontalLayout { height: 44px; padding-left: 16px; Text { text: "Clip timing"; color: root.accent; font-size: 12px; font-weight: 600; vertical-alignment: center; } }
                        ScrollView {
                            horizontal-stretch: 1; vertical-stretch: 1;
                            VerticalLayout {
                                padding: 14px; spacing: 12px;
                                Text { text: root.selected_clip_name; color: root.text; font-size: 12px; font-weight: 600; wrap: word-wrap; }
                                Text { text: "Timeline values are frames; source values are original stream ticks. End/out are exclusive."; color: root.secondary; font-size: 11px; wrap: word-wrap; }
                                TimingField { label: "Timeline start"; value: root.selected_clip_start; enabled: root.selected_clip_id != ""; committed(value) => { root.clip_timing_changed("start", value); } }
                                TimingField { label: "Timeline end"; value: root.selected_clip_end; enabled: root.selected_clip_id != ""; committed(value) => { root.clip_timing_changed("end", value); } }
                                TimingField { label: "Source in"; value: root.selected_clip_source_in; enabled: root.selected_clip_id != ""; committed(value) => { root.clip_timing_changed("source_in", value); } }
                                TimingField { label: "Source out"; value: root.selected_clip_source_out; enabled: root.selected_clip_id != ""; committed(value) => { root.clip_timing_changed("source_out", value); } }
                                Text { text: "Duration  " + root.selected_clip_duration + " frames"; color: root.secondary; font-size: 12px; }
                                Text { text: "Press Enter to apply a frame value. Drag a clip to move it; drag an edge to trim. Esc cancels a drag."; color: root.secondary; font-size: 11px; wrap: word-wrap; }
                                Rectangle { vertical-stretch: 1; }
                            }
                        }
                    }
                }
            }
            if root.nodes_open: Rectangle {
                height: 260px; background: root.panel;
                VerticalLayout {
                    spacing: 1px;
                    Rectangle {
                        height: 52px; background: #15181b;
                        HorizontalLayout {
                            spacing: 8px; padding-left: 14px; padding-right: 10px;
                            Text { text: "CLIPS"; width: 46px; color: root.secondary; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                            ScrollView {
                                vertical-scrollbar-policy: always-off;
                                HorizontalLayout {
                                    padding-top: 6px; padding-bottom: 6px; spacing: 6px;
                                    for clip in root.clips: Rectangle {
                                        width: 150px; height: 38px; border-radius: 4px;
                                        background: clip.selected ? #265d59 : #252a2f;
                                        border-width: 1px; border-color: clip.selected ? root.accent : root.border;
                                        if clip.has_thumbnail: Image { x: 3px; y: 3px; width: 46px; height: 32px; source: clip.thumbnail; image-fit: cover; }
                                        Text { x: clip.has_thumbnail ? 55px : 8px; width: parent.width - self.x - 6px; height: parent.height; text: clip.asset_name; color: clip.online ? root.text : #ffaaaa; font-size: 11px; overflow: elide; vertical-alignment: center; }
                                        TouchArea { accessible-role: button; accessible-label: "Pipeline for " + clip.asset_name; clicked => { editor_focus.focus(); root.clip_select(clip.id); } }
                                    }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 1px;
                        Rectangle {
                            width: 220px; background: #191c1f;
                            VerticalLayout {
                                padding: 10px; spacing: 6px;
                                Text { text: "Color tools"; color: root.accent; font-size: 12px; font-weight: 600; }
                                Text { text: "Add effect"; color: root.text; font-size: 12px; font-weight: 600; }
                                Text { text: "Insert after the selected node"; color: root.secondary; font-size: 11px; wrap: word-wrap; }
                                ScrollView {
                                    horizontal-scrollbar-policy: always-off;
                                    VerticalLayout {
                                        spacing: 5px;
                                        for effect in root.pipeline_effects: Button {
                                            text: effect.label;
                                            enabled: root.selected_clip_id != "" && !root.pipeline_busy && !root.pipeline_inspector_dirty;
                                            clicked => { root.pipeline_add_effect(effect.index); }
                                        }
                                    }
                                }
                            }
                        }
                        Inspector {
                            horizontal-stretch: 1; vertical-stretch: 1;
                            node-id: root.pipeline_node_id;
                            has-selection: root.pipeline_has_selection;
                            node-type: root.pipeline_node_type;
                            selection-message: root.pipeline_selection_message;
                            project-busy: root.pipeline_busy;
                            is-shader: root.pipeline_is_shader;
                            supports-output-size: root.pipeline_supports_output_size;
                            label-dirty: root.pipeline_label_dirty;
                            shader-dirty: root.pipeline_shader_dirty;
                            output-size-dirty: root.pipeline_output_size_dirty;
                            uniform-dirty: root.pipeline_uniform_dirty;
                            inspector-dirty: root.pipeline_inspector_dirty;
                            validation-message: root.pipeline_validation_message;
                            uniforms-valid: root.pipeline_uniforms_valid;
                            ports: root.pipeline_ports; uniforms: root.pipeline_uniforms; forms: root.pipeline_forms;
                            node-label <=> root.pipeline_node_label;
                            shader-code <=> root.pipeline_shader_code;
                            label-read-only: root.pipeline_label_read_only;
                            shader-read-only: root.pipeline_shader_read_only;
                            can-delete: root.pipeline_can_delete;
                            auto-size <=> root.pipeline_auto_size;
                            output-width <=> root.pipeline_output_width;
                            output-height <=> root.pipeline_output_height;
                            label-draft-changed(value) => { root.pipeline_label_draft_changed(value); }
                            shader-draft-changed(value) => { root.pipeline_shader_draft_changed(value); }
                            output-size-draft-changed(w, h, auto) => { root.pipeline_output_size_draft_changed(w, h, auto); }
                            uniform-draft-changed(name, value) => { root.pipeline_uniform_draft_changed(name, value); }
                            form-draft-changed(key, value) => { root.pipeline_form_draft_changed(key, value); }
                            apply-form(key) => { root.pipeline_apply_form(key); }
                            apply-label => { root.pipeline_action("apply-label"); }
                            apply-shader => { root.pipeline_action("apply-shader"); }
                            apply-output-size => { root.pipeline_action("apply-output-size"); }
                            apply-uniforms => { root.pipeline_action("apply-uniforms"); }
                            discard-drafts => { root.pipeline_action("discard-drafts"); }
                            delete-node => { root.pipeline_action("remove-nodes"); }
                        }
                    }
                }
            }
            Rectangle {
                height: root.nodes_open ? 220px : 280px; background: #191c1e;
                VerticalLayout {
                    spacing: 0px;
                    HorizontalLayout {
                        height: 44px; padding-left: 16px; padding-right: 16px; spacing: 8px; cross-axis-alignment: center;
                        Text { text: "Timeline"; color: root.text; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                        Rectangle { width: 1px; height: 20px; background: root.border; }
                        Text { text: "Main track"; color: root.secondary; font-size: 12px; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        ToolButton { label: "ADD CLIP"; glyph: "+"; active: root.assets.length > 0; clicked => { editor_focus.focus(); root.add_to_timeline(); } }
                        ToolButton { label: "SPLIT"; glyph: "✂"; active: root.selected_clip_id != ""; clicked => { editor_focus.focus(); root.split_clip(); } }
                        ToolButton { label: "DELETE"; glyph: "⌫"; active: root.selected_clip_id != ""; clicked => { editor_focus.focus(); root.lift_clip(); } }
                        Rectangle { width: 1px; height: 20px; background: root.border; }
                        ToolButton { label: "FIT TIMELINE"; glyph: "fit"; tooltip-text: "Fit entire sequence"; active: root.sequence_duration > 0; clicked => { root.fit_timeline(); } }
                        ToolButton { label: "ZOOM OUT"; glyph: "−"; active: root.timeline_zoom > 0.0001; clicked => { root.set_zoom(root.timeline_zoom > 4 ? root.timeline_zoom - 2 : root.timeline_zoom / 2); } }
                        Text { text: root.timeline_zoom >= 1 ? Math.round(root.timeline_zoom * 100) / 100 + " px/f" : Math.round(100 / root.timeline_zoom) / 100 + " f/px"; width: 88px; color: root.secondary; font-size: 11px; vertical-alignment: center; horizontal-alignment: center; }
                        ToolButton { label: "ZOOM IN"; glyph: "+"; active: root.timeline_zoom < 48; clicked => { root.set_zoom(root.timeline_zoom >= 4 ? root.timeline_zoom + 2 : root.timeline_zoom * 2); } }
                    }
                    HorizontalLayout {
                        spacing: 0px; vertical-stretch: 1;
                        Rectangle { width: 84px; background: #1b1e21; Text { y: 52px; width: parent.width; height: 72px; text: "Video 1\nV1"; color: root.accent; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; } }
                        timeline_scroll := ScrollView {
                            horizontal-stretch: 1; vertical-stretch: 1;
                            content-width: max(self.visible-width, root.timeline_content_width * 1px);
                            content-height: self.visible-height;
                            Rectangle {
                                width: timeline_scroll.content-width; height: timeline_scroll.content-height; background: #17191b;
                                Rectangle { width: parent.width; height: 32px; background: #131517; }
                                Rectangle { y: 46px; width: parent.width; height: 84px; background: #1e2527; }
                                for tick in Math.ceil(timeline_scroll.visible-width / 1px / max(0.0001, root.timeline_zoom) / root.ruler_step) + 2: Rectangle {
                                    private property <int> frame: (tick + Math.floor(-timeline_scroll.content-x / 1px / max(0.0001, root.timeline_zoom) / root.ruler_step)) * root.ruler_step;
                                    x: 10px + self.frame * root.timeline_zoom * 1px; width: 1px; height: parent.height; background: #242a2d;
                                    Rectangle { width: 1px; height: 9px; y: 23px; background: #68737a; }
                                    Text { x: 5px; y: 4px; width: 90px; height: 20px; text: root.ruler_label(parent.frame); color: root.secondary; font-size: 11px; vertical-alignment: center; }
                                }
                                TouchArea {
                                    clicked => { editor_focus.focus(); root.seek_frame(max(0, Math.round((self.mouse-x / 1px - 10) / max(0.0001, root.timeline_zoom)))); }
                                }
                                for clip in root.clips: TimelineClip {
                                    item: clip; zoom: root.timeline_zoom; cancel_token: root.cancel_token;
                                    focused => { editor_focus.focus(); }
                                    clicked => { root.clip_select(clip.id); }
                                    gesture(kind, delta) => { root.clip_gesture(clip.id, kind, delta); }
                                }
                                Rectangle { x: 10px + root.selected_frame * root.timeline_zoom * 1px; width: 2px; height: parent.height; background: #ff525b; }
                                Rectangle { x: 6px + root.selected_frame * root.timeline_zoom * 1px; y: 1px; width: 10px; height: 10px; background: #ff525b; border-radius: 2px; }
                            }
                        }
                    }
                    Rectangle { height: 30px; background: #151719; HorizontalLayout { padding-left: 12px; padding-right: 12px; Text { text: root.clips.length + " clips · " + root.sequence_duration + " frames"; color: root.secondary; font-size: 11px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } Text { text: "Space play · ← / → step · ⌘/Ctrl+B split · Esc cancel"; color: root.secondary; font-size: 11px; vertical-alignment: center; } } }
                }
            }
            Rectangle { height: 26px; background: #121415; HorizontalLayout { padding-left: 12px; padding-right: 12px; Text { text: root.project_status; color: #939ba2; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; } Text { text: root.project_data_width + " × " + root.project_data_height + " · " + root.sequence_fps + " fps"; color: #939ba2; font-size: 11px; vertical-alignment: center; } } }
        }
        if root.settings_open: Rectangle {
            width: parent.width; height: parent.height; background: #000000b0;
            TouchArea { clicked => { root.settings_open = false; editor_focus.focus(); } }
            Rectangle {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                width: 420px; height: 432px; background: root.panel;
                border-width: 1px; border-color: root.border; border-radius: 10px;
                TouchArea { }
                VerticalLayout {
                    padding: 24px; spacing: 10px;
                    Text { text: "Sequence settings"; color: root.text; font-size: 18px; font-weight: 700; }
                    Text { text: "Frame dimensions and rational frame rate. Enter whole numbers; the project validates changes."; color: root.secondary; font-size: 11px; wrap: word-wrap; }
                    Text { text: "Width (pixels)"; color: root.secondary; font-size: 12px; }
                    LineEdit { accessible-label: "Sequence width"; text <=> root.draft_width; }
                    Text { text: "Height (pixels)"; color: root.secondary; font-size: 12px; }
                    LineEdit { accessible-label: "Sequence height"; text <=> root.draft_height; }
                    Text { text: "FPS numerator / denominator (e.g. 30000 / 1001)"; color: root.secondary; font-size: 12px; }
                    HorizontalLayout {
                        spacing: 10px;
                        LineEdit { accessible-label: "FPS numerator"; text <=> root.draft_fps_numerator; }
                        Text { text: "/"; color: root.secondary; vertical-alignment: center; }
                        LineEdit { accessible-label: "FPS denominator"; text <=> root.draft_fps_denominator; }
                    }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: 10px;
                        Button { text: "Cancel"; clicked => { root.settings_open = false; editor_focus.focus(); } }
                        Button { text: "Apply settings"; primary: true; clicked => { root.sequence_settings(root.draft_width, root.draft_height, root.draft_fps_numerator, root.draft_fps_denominator); root.settings_open = false; editor_focus.focus(); } }
                    }
                }
            }
        }
        if root.file_dialog_open: Rectangle {
            width: parent.width; height: parent.height; background: #000000b0;
            accessible-role: groupbox;
            accessible-label: "File dialog";
            accessible-description: "Action " + root.file_dialog_kind + "; path " + root.file_path;
            TouchArea { clicked => { root.file_dialog_open = false; editor_focus.focus(); } }
            Rectangle {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                width: 680px; height: 264px; background: root.panel;
                border-width: 1px; border-color: root.border; border-radius: 10px;
                TouchArea { }
                VerticalLayout {
                    padding: 24px; spacing: 12px;
                    Text { text: root.file_dialog_kind == "import" ? "Import media" : root.file_dialog_kind == "open" ? "Open project" : root.file_dialog_kind == "save-as" ? "Save project as" : "Relink missing media"; color: root.text; font-size: 18px; font-weight: 700; }
                    Text { text: "Paste a full local file path, or use Browse to choose a file."; color: root.secondary; font-size: 11px; }
                    HorizontalLayout {
                        spacing: 10px;
                        LineEdit {
                            accessible-label: "File path";
                            text <=> root.file_path;
                            placeholder-text: root.file_dialog_kind == "import" || root.file_dialog_kind == "relink" ? "/path/to/video.mp4" : "/path/to/project.oqvideo.json";
                            accepted(value) => { root.submit_file(); }
                        }
                        Button { text: "Browse…"; clicked => { root.project_action("browse-" + root.file_dialog_kind); } }
                    }
                    Text { text: root.io_status; color: root.secondary; font-size: 11px; wrap: word-wrap; }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: 10px;
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: "Cancel"; clicked => { root.file_dialog_open = false; editor_focus.focus(); } }
                        Button { text: root.file_dialog_kind == "save-as" ? "Save project" : root.file_dialog_kind == "open" ? "Open project" : root.file_dialog_kind == "relink" ? "Relink media" : "Import media"; primary: true; clicked => { root.submit_file(); } }
                    }
                }
            }
        }
    }
}
