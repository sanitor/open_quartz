{
  "name": "open-quartz",
  "private": true,
  "version": "0.20.0b",
  "type": "module",
  "scripts": {
    "dev": "node scripts/desktop.mjs dev",
    "build": "node scripts/desktop.mjs build",
    "prepare:desktop": "node scripts/desktop.mjs prepare",
    "test:desktop": "node scripts/desktop.mjs test",
    "test:desktop:ui": "node scripts/desktop.mjs test-ui",
    "dev:editor": "cargo run --manifest-path crates/slint_code_editor/Cargo.toml --example editor",
    "test:editor": "cargo test --manifest-path crates/slint_code_editor/Cargo.toml --locked",
    "test:desktop:shaders": "node scripts/desktop.mjs test-ui-shaders",
    "prepare:inference": "node scripts/prepare-inference-e2e.mjs",
    "test:desktop:inference": "node scripts/desktop.mjs test-inference",
    "test:desktop:inference:ui": "node scripts/desktop.mjs test-ui-inference",
    "test:desktop:inference:performance": "node scripts/desktop.mjs test-inference-performance",
    "report:desktop:ui": "node scripts/slint-ui-report.mjs",
    "dev:desktop:ui": "node scripts/desktop.mjs dev-ui",
    "build:desktop:ui": "node scripts/desktop.mjs build-ui",
    "test:sdk-coverage": "node scripts/test-sdk-coverage.mjs",
    "check:rust-boundaries": "node scripts/check-rust-boundaries.mjs",
    "copy:ffmpeg": "node scripts/copy-ffmpeg.mjs",
    "build:screensaver-stub": "node scripts/build-screensaver-stub.mjs",
    "clean": "rm -rf dist-desktop node_modules/.cache/open-quartz apps/open_quartz_slint/target apps/open_quartz_slint/runtime target/screensaver-stub"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0"
  }
}
